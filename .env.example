# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/clickcamp

# --- CORS: comma-separated list of allowed frontend origins ---
CLIENT_URLS=http://localhost:3000,http://localhost:3001

# --- Admin auth ---
ADMIN_JWT_SECRET=change-this-to-a-long-random-string
ADMIN_JWT_EXPIRES_IN=8h

# --- Used to build shareable referral links returned in API responses ---
USER_SITE_URL=http://localhost:3000

# --- Cloudinary (offer images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Seed script (npm run seed:admin) ---
SEED_ADMIN_NAME=ClickCamp Admin
SEED_ADMIN_EMAIL=tshivavakiti@gmail.com
SEED_ADMIN_PASSWORD=T.shiv@2@@42##4
